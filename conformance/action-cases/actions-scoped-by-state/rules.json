{
    "version": 1,
    "name": "Page and action target",
    "state": [
        {
            "name": "page",
            "keys": ["ui.url"],
            "required": true
        }
    ],
    "capture": "ignore",
    "actions": {
        "type": [
            {
                "op": "map",
                "values": {
                    "tap": "click"
                }
            }
        ],
        "target": [
            {
                "name": "name",
                "keys": ["ui.name"],
                "required": true
            }
        ]
    }
}
