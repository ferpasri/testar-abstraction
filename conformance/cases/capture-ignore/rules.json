{
    "version": 1,
    "name": "Page without capture-status distinction",
    "state": [
        {
            "name": "title",
            "keys": ["ui.title"],
            "required": true,
            "transforms": [
                {
                    "op": "trim"
                },
                {
                    "op": "collapse_whitespace"
                }
            ]
        },
        {
            "name": "address",
            "keys": ["ui.url"],
            "required": true,
            "transforms": [
                {
                    "op": "url",
                    "remove_path_parameters": ["jsessionid"],
                    "remove_query": ["session"],
                    "remove_fragment": true
                }
            ]
        }
    ],
    "capture": "ignore"
}
