{
    "version": 1,
    "name": "Stable widgets",
    "state": [
        {
            "name": "address",
            "keys": ["ui.url"],
            "required": true
        }
    ],
    "capture": "same",
    "widgets": {
        "fields": [
            {
                "name": "role",
                "keys": ["ui.role"]
            },
            {
                "name": "name",
                "keys": ["ui.name"]
            }
        ],
        "exclude": [
            {
                "keys": ["ui.dynamic"],
                "op": "equals",
                "value": true
            }
        ],
        "hierarchy": "flat",
        "order": "sort",
        "descendants": "exclude"
    }
}
